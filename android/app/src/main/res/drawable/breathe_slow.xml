<?xml version="1.0" encoding="utf-8"?>
<!-- Slow hypnotic breath. Uneven frame lengths so the loop never feels metronomic. -->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android" android:oneshot="false">
    <item android:drawable="@drawable/ring_1" android:duration="1400" />
    <item android:drawable="@drawable/ring_2" android:duration="900" />
    <item android:drawable="@drawable/ring_3" android:duration="1100" />
    <item android:drawable="@drawable/ring_4" android:duration="700" />
    <item android:drawable="@drawable/ring_2" android:duration="1300" />
</animation-list>
