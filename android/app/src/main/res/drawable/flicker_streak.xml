<?xml version="1.0" encoding="utf-8"?>
<!-- Streak indicator: a faint white flame-dot that flickers irregularly. -->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android" android:oneshot="false">
    <item android:drawable="@drawable/dot_bright" android:duration="240" />
    <item android:drawable="@drawable/dot_dim" android:duration="120" />
    <item android:drawable="@drawable/dot_bright" android:duration="90" />
    <item android:drawable="@drawable/dot_faint" android:duration="380" />
    <item android:drawable="@drawable/dot_dim" android:duration="160" />
</animation-list>
